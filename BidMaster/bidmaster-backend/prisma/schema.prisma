// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  buyer
  seller
  admin
}
 
enum AdminLevel {
  admin
  moderator
}
 
enum ProductState {
  new
  used
}
 
enum AuctionStatus {
  active
  soon
  ended
}
 
model User {
  id       Int    @id @default(autoincrement())
  name     String
  lastname String
  password String
  email    String @unique
  role     Role
 
  // Buyer-specific
  deliveryAddress String?
 
  // Seller-specific
  payoutInfo String?
  storeName  String?
 
  // Admin-specific
  level AdminLevel?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  products Product[] @relation("SellerProducts")
  bids     Bid[]
 
  @@map("users")
}
 
model Product {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  price       Decimal      @db.Decimal(10, 2)
  category    String
  image       String[]
  state       ProductState
 
  sellerId Int
  seller   User @relation("SellerProducts", fields: [sellerId], references: [id])
 
  auction Auction?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@map("products")
}
 
model Auction {
  id             Int           @id @default(autoincrement())
  startingPrice  Decimal       @db.Decimal(10, 2)
  currentPrice   Decimal       @db.Decimal(10, 2)
  hammerPrice    Decimal?      @db.Decimal(10, 2)
  minimalBidStep Decimal       @db.Decimal(10, 2)
  reservePrice   Decimal?      @db.Decimal(10, 2)
  startDate      DateTime
  endDate        DateTime
  status         AuctionStatus @default(soon)
  bidCounter     Int           @default(0)
 
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id])
 
  bids Bid[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@map("auctions")
}
 
model Bid {
  id           Int      @id @default(autoincrement())
  biddingPrice Decimal  @db.Decimal(10, 2)
  offerTime    DateTime @default(now())
 
  auctionId Int
  auction   Auction @relation(fields: [auctionId], references: [id])
 
  buyerId Int
  buyer   User @relation(fields: [buyerId], references: [id])
 
  @@map("bids")
}